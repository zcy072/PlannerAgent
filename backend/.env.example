# ===========================================
# LLM 配置
# ===========================================

# 默认 LLM 提供商: deepseek / aliyun / openai
LLM_PROVIDER=deepseek

# 单次 LLM 请求超时（秒）与重试次数
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼配置
ALIYUN_DASHSCOPE_API_KEY=your_aliyun_api_key
ALIYUN_MODEL=qwen-plus

# OpenAI 配置 (可选)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview

# ===========================================
# LangSmith 配置 (Agent 可观测性)
# ===========================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=trip-planner-agent

# ===========================================
# 高德地图 API
# ===========================================
AMAP_API_KEY=your_amap_api_key

# 高德 MCP（可选：填写高德 Web 服务 Key，用于真实道路路线校验）
AMAP_MCP_API_KEY=
AMAP_MCP_ENABLED=false
AMAP_MCP_URL=https://mcp.amap.com/mcp
AMAP_MCP_MAX_ROUTE_LEGS=12
# Optional MCP safety limits (seconds); failures fall back to coordinate estimates.
AMAP_MCP_TIMEOUT_SECONDS=15
AMAP_MCP_CALL_TIMEOUT_SECONDS=8

# Amap forecasts cover only the next few days. Dates beyond that are filled from
# Open-Meteo (free, no key, up to 16 days). Failure only degrades to "no forecast".
OPEN_METEO_ENABLED=true

# ===========================================
# 服务器配置
# ===========================================
HOST=0.0.0.0
PORT=8100
DEBUG=false

# ===========================================
# CORS 配置
# ===========================================
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# 数据保留
# ===========================================
# 失败续跑用的 checkpoint 保留天数（启动时清理）；0 表示不清理
CHECKPOINT_RETENTION_DAYS=7
# 已保存行程 JSON 的保留天数；0 表示永久保留
RESULT_RETENTION_DAYS=0

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=INFO
